{
  "Jwt": {
    "Key": "",
    "Issuer": "NewsPortalAPI",
    "Audience": "NewsPortalUsers",
    "AccessTokenExpiryInMinutes": 30,
    "RefreshTokenExpiryInDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*"
}